{
  "$comment": "The harness registry: the only place a harness, its category and tier, and its install paths are written down. Read through scripts/harnesses.py. Ranking and categories: docs/harness-ecosystem.md. Paths use ~ for the home directory and {name} for the ruleset or agent name.",
  "version": 1,
  "categories": {
    "pro-code": "Coding agents that read a repository; the House installs its artifacts into them.",
    "low-code": "Visual agent builders; the House reaches them over MCP and A2A.",
    "data-workspace": "Agents inside one data platform; installable, outside both tens.",
    "standard": "An open standard many harnesses read, used as an install target of its own."
  },
  "tiers": {
    "top-ten": "One of the ten its category commits to, held to the conformance check.",
    "watch": "One quarter's evidence from its category's ten."
  },
  "harnesses": [
    {
      "id": "claude-code", "name": "Claude Code", "vendor": "Anthropic",
      "category": "pro-code", "tier": "top-ten", "rank": 1, "adapter": "claude-code",
      "surfaces": {
        "skills": {"global": "~/.claude/skills", "project": ".claude/skills"},
        "rules": {"global": "~/.claude/CLAUDE.md", "project": "CLAUDE.md"},
        "agents": {"project": ".claude/agents/{name}.md", "keys": ["name", "description", "tools", "model"]}
      }
    },
    {
