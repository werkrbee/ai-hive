{
  "$schema": "../../schema/approval-policy.schema.json",
  "policy": "queen-charter",
  "version": 3,
  "description": "The Queen Bee's Charter's approval rules. Local, reversible actions run without asking. Consequential, irreversible or externally visible actions need a human to approve the specific action. Anything else is denied. Editing or deleting an audit log, and answering the human review queue, are prohibited outright.",
  "source": "hives/rules-hive/rules/queen-charter/AGENTS.md",
  "actions": [
    {
      "id": "audit.edit",
      "description": "Edit, truncate or rewrite an audit log.",
      "gated": true
    },
    {
      "id": "audit.delete",
      "description": "Delete an audit log.",
      "gated": true
    },
    {
      "id": "queue.answer",
      "description": "Answer an item in the human review queue: an approval, an escalation or drift.",
      "gated": true
    }
  ],
  "prohibitions": [
    {
      "id": "audit.no-edit",
      "action": "audit.edit",
      "reason": "No agent edits, truncates or rewrites an audit log (the Charter's first principles)."
    },
    {
      "id": "audit.no-delete",
      "action": "audit.delete",
      "reason": "No agent deletes an audit log (the Charter's first principles). Archiving one is a human's infrastructure change."
    },
    {
      "id": "queue.no-answer",
      "action": "queue.answer",
      "reason": "Only a person answers the review queue; an agent never answers its own, or any other agent's (the Charter's human gates)."
    }
  ],
  "mandates": [
    {
      "id": "auto.fs.read",
      "type": "mandate.action.open.1",
      "action": "fs.read"
    },
    {
      "id": "auto.fs.write",
      "type": "mandate.action.open.1",
      "action": "fs.write"
    },
    {
      "id": "auto.shell.exec",
      "type": "mandate.action.open.1",
      "action": "shell.exec"
    },
    {
      "id": "auto.net.fetch",
      "type": "mandate.action.open.1",
      "action": "net.fetch"
    },
    {
      "id": "auto.agent.delegate",
      "type": "mandate.action.open.1",
      "action": "agent.delegate"
    },
    {
      "id": "approve.vcs.commit",
      "type": "mandate.action.1",
      "action": "vcs.commit"
    },
    {
      "id": "approve.vcs.push",
      "type": "mandate.action.1",
      "action": "vcs.push"
    },
    {
      "id": "approve.vcs.merge",
      "type": "mandate.action.1",
      "action": "vcs.merge"
    },
    {
      "id": "approve.vcs.release",
      "type": "mandate.action.1",
      "action": "vcs.release"
    },
    {
      "id": "approve.vcs.delete-ref",
      "type": "mandate.action.1",
      "action": "vcs.delete-ref"
    },
    {
      "id": "approve.fs.delete",
      "type": "mandate.action.1",
      "action": "fs.delete"
    },
    {
      "id": "approve.infra.change",
      "type": "mandate.action.1",
      "action": "infra.change"
    },
    {
      "id": "approve.deploy",
      "type": "mandate.action.1",
      "action": "deploy"
    },
    {
      "id": "approve.message.send",
      "type": "mandate.action.1",
      "action": "message.send"
    },
    {
      "id": "approve.spend",
      "type": "mandate.action.1",
      "action": "spend"
    }
  ]
}
