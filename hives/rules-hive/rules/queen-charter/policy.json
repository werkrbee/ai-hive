{
  "$schema": "../../schema/approval-policy.schema.json",
  "policy": "queen-charter",
  "version": 1,
  "description": "The Queen Bee's Charter's approval rules. Local, reversible actions run without asking. Consequential, irreversible or externally visible actions need a human to approve the specific action. Anything else is denied.",
