[
  {
    "name": "reading files runs on its own",
    "request": {
      "action": "fs.read"
    },
    "decision": "auto",
    "rule": "auto.fs.read"
  },
  {
    "name": "running a shell command runs on its own",
    "request": {
      "action": "shell.exec"
    },
    "decision": "auto",
    "rule": "auto.shell.exec"
  },
  {
    "name": "a commit needs approval",
    "request": {
      "action": "vcs.commit"
    },
    "decision": "human",
    "rule": "approve.vcs.commit"
  },
  {
    "name": "a merge needs approval",
    "request": {
      "action": "vcs.merge"
    },
    "decision": "human",
    "rule": "approve.vcs.merge"
  },
  {
    "name": "sending a message needs approval",
    "request": {
      "action": "message.send"
    },
    "decision": "human",
    "rule": "approve.message.send"
  },
  {
    "name": "spending needs approval",
    "request": {
      "action": "spend"
    },
    "decision": "human",
    "rule": "approve.spend"
  },
  {
    "name": "editing an audit log is prohibited",
    "request": {
      "action": "audit.edit"
    },
    "decision": "deny",
    "rule": "audit.no-edit"
  },
  {
    "name": "deleting an audit log is prohibited",
    "request": {
      "action": "audit.delete"
    },
    "decision": "deny",
    "rule": "audit.no-delete"
  },
  {
    "name": "answering the review queue is prohibited",
    "request": {
      "action": "queue.answer"
    },
    "decision": "deny",
    "rule": "queue.no-answer"
  },
  {
    "name": "delegating to a listed agent, passing context explicitly, runs on its own",
    "request": {
      "action": "agent.delegate",
      "scope": {
        "passport": "explore"
      },
      "facts": {
        "delegate.listed": true,
        "context.whole": false
      }
    },
    "decision": "auto",
    "rule": "auto.agent.delegate"
  },
  {
    "name": "delegating to an agent the passport doesn't list is prohibited",
    "request": {
      "action": "agent.delegate",
      "scope": {
        "passport": "deploy-bot"
      },
      "facts": {
        "delegate.listed": false,
        "context.whole": false
      }
    },
    "decision": "deny",
    "rule": "delegate.unlisted"
  },
  {
    "name": "a delegation that doesn't say whether its delegate is listed is prohibited",
    "request": {
      "action": "agent.delegate",
      "scope": {
        "passport": "explore"
      },
      "facts": {
        "context.whole": false
      }
    },
    "decision": "deny",
    "rule": "delegate.unlisted"
  },
  {
    "name": "handing a delegate the whole context is prohibited",
    "request": {
      "action": "agent.delegate",
      "scope": {
        "passport": "explore"
      },
      "facts": {
        "delegate.listed": true,
        "context.whole": true
      }
    },
    "decision": "deny",
    "rule": "delegate.whole-context"
  },
  {
    "name": "a delegation that doesn't say what context it passes is prohibited",
    "request": {
      "action": "agent.delegate",
      "scope": {
        "passport": "explore"
      },
      "facts": {
        "delegate.listed": true
      }
    },
    "decision": "deny",
    "rule": "delegate.whole-context"
  },
  {
    "name": "an action no mandate covers is denied",
    "request": {
      "action": "db.drop"
    },
    "decision": "deny"
  }
]
