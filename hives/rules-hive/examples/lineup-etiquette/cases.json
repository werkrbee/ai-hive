  { "name": "a player can't cancel an event",
    "request": { "action": "lineup.event.cancel", "facts": { "actor.role": "player" } },
    "decision": "deny" },
  { "name": "charging money needs approval (from the Charter)",
    "request": { "action": "spend" },
