                 "trigger": "bullpen.slot-opened", "facts": { "recipient.notifyOptIn": false } },
    "decision": "deny" },
  { "name": "a bullpen text without the slot-opened trigger needs the organizer",
    "request": { "action": "message.send", "scope": { "channel": "sms", "audience": "bullpen" },
                 "facts": { "recipient.notifyOptIn": true } },
    "decision": "human" },
  { "name": "an organizer blast needs approval",
    "request": { "action": "message.send", "scope": { "channel": "sms", "audience": "group" },
                 "facts": { "recipient.notifyOptIn": true } },
    "decision": "human" },
  { "name": "a blast to members who didn't opt in is denied, even with approval",
    "request": { "action": "message.send", "scope": { "channel": "sms", "audience": "group" } },
    "decision": "deny" },
  { "name": "an organizer cancelling an event needs approval",
