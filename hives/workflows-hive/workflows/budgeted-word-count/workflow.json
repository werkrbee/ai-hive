{
  "name": "budgeted-word-count",
  "version": 1,
  "description": "Read a text file, then count its words and lines, each step within a budget.",
  "inputs": {
    "type": "object",
    "properties": { "path": { "type": "string" } },
    "required": ["path"]
  },
  "steps": [
    { "id": "read", "worker": "read-text", "input": { "path": "${inputs.path}" },
      "budget": { "usd": 0.01, "tokens": 10000 } },
    { "id": "count", "worker": "count-words", "input": { "text": "${steps.read.output}" },
      "budget": { "usd": 0.01, "tokens": 10000, "seconds": 30 } }
  ],
  "output": "${steps.count.output}"
}
